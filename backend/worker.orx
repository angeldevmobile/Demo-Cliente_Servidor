-- Worker de la cola: `orion run backend/worker.orx`.
-- Pueden ejecutarse varios a la vez sin procesar un trabajo dos veces.
use "db" as db
use "json" as json
use "env" as entorno
use "timewarp" as tw
use "backend/base/config" as config
use "backend/base/bd" as bd
use "backend/sistema/cola" as cola
use "backend/panel/informes" as informes
use "backend/cobro/facturas" as facturas
use "backend/sistema/monitor" as monitor
use "backend/cobro/pagos" as pagos
use "backend/base/limite" as limite

NOMBRE  = entorno.get("ORION_WORKER", "worker-1")
DESCANSO = entorno.get("ORION_DESCANSO", "500ms")
-- Trabajos a procesar antes de terminar. 0 = sin límite; un número sirve para pruebas.
TOPE = int(entorno.get("ORION_TOPE", "0"))

fn procesar(t) {
    if t["tipo"] == "factura" {
        facturas.generar(int(json.parse(t["datos"])["pedido_id"]))
        return
    }
    if t["tipo"] == "correo_factura" {
        show "  " + facturas.enviar(int(json.parse(t["datos"])["pedido_id"]))
        return
    }
    if t["tipo"] == "informe" {
        informes.generar(int(json.parse(t["datos"])["informe_id"]))
        return
    }
    error("tipo de trabajo desconocido: " + t["tipo"])
}

-- Si un informe agota sus intentos, se marca como fallido para que el panel lo muestre.
fn rendirse(t, mensaje) {
    if t["tipo"] == "informe" {
        attempt {
            informes.marcar_fallido(int(json.parse(t["datos"])["informe_id"]), mensaje)
        } handle err {
            show "  no se pudo marcar el informe como fallido: " + str(err)
        }
    }
}

bd.crear_esquema()

show "Worker " + NOMBRE + " escuchando la cola"
show ""

hechos = 0
rescate = tw.clock()
monitor.latido(NOMBRE, "worker")
latido = tw.clock()
cobros = tw.clock()

while yes {
    -- Cada minuto, devuelve a la cola los trabajos de workers detenidos
    -- y borra los contadores de peticiones ya cerrados.
    if tw.elapsed(rescate) > 60.0 {
        cola.rescatar(5)
        limite.limpiar()
        rescate = tw.clock()
    }

    -- Cada 30 s: caduca pedidos sin pagar y concilia pagos con la pasarela.
    if tw.elapsed(cobros) > 30.0 {
        attempt {
            n = pagos.caducar()
            if n > 0 {
                show "  " + str(n) + " pedido(s) sin pagar caducados; stock devuelto"
            }
            n = pagos.conciliar()
            if n > 0 {
                show "  " + str(n) + " pago(s) recuperados por conciliación"
            }
        } handle err {
            show "  pagos: " + str(err)
        }
        cobros = tw.clock()
    }

    -- Señal de vida cada 5 s, no en cada vuelta del bucle.
    if tw.elapsed(latido) > 5.0 {
        monitor.latido(NOMBRE, "worker")
        latido = tw.clock()
    }

    t = cola.tomar(NOMBRE)

    if t == null {
        -- Con TOPE, la cola vacía termina el worker (pruebas). Sin TOPE, espera indefinidamente.
        if TOPE > 0 {
            break
        }
        tw.wait(DESCANSO)
    } else {
        attempt {
            procesar(t)
            cola.terminar(t["id"])
            show "  trabajo " + str(t["id"]) + " (" + t["tipo"] + ") hecho"
        } handle err {
            que = cola.fallar(t["id"], str(err), t["intentos"], t["max_intentos"])
            if que == "fallido" {
                rendirse(t, str(err))
            }
            show "  trabajo " + str(t["id"]) + " fallo (" + que + "): " + str(err)
        }
        hechos = hechos + 1
        if TOPE > 0 and hechos >= TOPE {
            break
        }
    }
}

show ""
show "Worker " + NOMBRE + " termina tras " + str(hechos) + " trabajos"

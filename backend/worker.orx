-- Worker de la cola: `orion run backend/worker.orx`. Pueden correr varios, en
-- cualquier máquina, sin procesar nada dos veces.
use "db" as db
use "json" as json
use "env" as entorno
use "timewarp" as tw
use "backend/config" as config
use "backend/bd" as bd
use "backend/cola" as cola
use "backend/informes" as informes
use "backend/facturas" as facturas
use "backend/monitor" as monitor
use "backend/pagos" as pagos

NOMBRE  = entorno.get("ORION_WORKER", "worker-1")
DESCANSO = entorno.get("ORION_DESCANSO", "500ms")
-- Cuántos trabajos procesar antes de salir. 0 = sin fin (lo normal en un
-- servidor); un número concreto sirve para las pruebas.
TOPE = int(entorno.get("ORION_TOPE", "0"))

fn procesar(t) {
    if t["tipo"] == "factura" {
        facturas.generar(int(json.parse(t["datos"])["pedido_id"]))
        return
    }
    if t["tipo"] == "correo_factura" {
        show "  " + facturas.enviar(int(json.parse(t["datos"])["pedido_id"]))
        return
    }
    if t["tipo"] == "informe" {
        informes.generar(int(json.parse(t["datos"])["informe_id"]))
        return
    }
    error("tipo de trabajo desconocido: " + t["tipo"])
}

-- Cuando la cola se rinde con un informe, el panel tiene que enterarse: si
-- no, se quedaría "pendiente" para siempre esperando a un worker que ya no
-- lo va a intentar.
fn rendirse(t, mensaje) {
    if t["tipo"] == "informe" {
        attempt {
            informes.marcar_fallido(int(json.parse(t["datos"])["informe_id"]), mensaje)
        } handle err {
            show "  no se pudo marcar el informe como fallido: " + str(err)
        }
    }
}

bd.crear_esquema()

show "Worker " + NOMBRE + " escuchando la cola"
show ""

hechos = 0
rescate = tw.clock()
monitor.latido(NOMBRE, "worker")
latido = tw.clock()
cobros = tw.clock()

while yes {
    -- De vez en cuando, devolver a la cola lo que quedó atascado en un worker
    -- que murió a medias.
    if tw.elapsed(rescate) > 60.0 {
        cola.rescatar(5)
        rescate = tw.clock()
    }

    -- Cada 30 s: devolver el stock de lo que no se pagó a tiempo y preguntar a
    -- la pasarela por los pagos cuyo aviso no llegó.
    if tw.elapsed(cobros) > 30.0 {
        attempt {
            n = pagos.caducar()
            if n > 0 {
                show "  " + str(n) + " pedido(s) sin pagar caducados; stock devuelto"
            }
            n = pagos.conciliar()
            if n > 0 {
                show "  " + str(n) + " pago(s) recuperados por conciliación"
            }
        } handle err {
            show "  pagos: " + str(err)
        }
        cobros = tw.clock()
    }

    -- Señal de vida cada 5 s, no en cada vuelta: con la cola vacía el bucle
    -- da dos vueltas por segundo.
    if tw.elapsed(latido) > 5.0 {
        monitor.latido(NOMBRE, "worker")
        latido = tw.clock()
    }

    t = cola.tomar(NOMBRE)

    if t == null {
        -- Con TOPE puesto, la cola vacía significa "ya está": es el modo de
        -- las pruebas. Sin TOPE, el worker espera trabajo indefinidamente,
        -- que es lo que hace en un servidor.
        if TOPE > 0 {
            break
        }
        tw.wait(DESCANSO)
    } else {
        attempt {
            procesar(t)
            cola.terminar(t["id"])
            show "  trabajo " + str(t["id"]) + " (" + t["tipo"] + ") hecho"
        } handle err {
            que = cola.fallar(t["id"], str(err), t["intentos"], t["max_intentos"])
            if que == "fallido" {
                rendirse(t, str(err))
            }
            show "  trabajo " + str(t["id"]) + " fallo (" + que + "): " + str(err)
        }
        hechos = hechos + 1
        if TOPE > 0 and hechos >= TOPE {
            break
        }
    }
}

show ""
show "Worker " + NOMBRE + " termina tras " + str(hechos) + " trabajos"

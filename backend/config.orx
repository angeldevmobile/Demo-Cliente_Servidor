-- Configuración leída de variables de entorno.
use "env" as entorno

PORT = int(entorno.get("PORT", "8083"))

-- Por defecto, el Postgres del docker-compose (puerto 5433).
BD = entorno.get("ORION_BD", "postgres://comercio:comercio@127.0.0.1:5433/comercio")

FRONTEND = entorno.get("ORION_FRONTEND", "frontend")

-- Nombre de esta instancia; con varias detrás del balanceador, identifica quién atendió.
INSTANCIA = entorno.get("ORION_INSTANCIA", "local")

-- Secreto de firma de los JWT. En producción debe venir del entorno.
JWT_SECRETO = entorno.get("ORION_JWT", "cambia-esto-en-produccion")
JWT_HORAS   = int(entorno.get("ORION_JWT_HORAS", "12"))

-- Cuenta de administración que se crea al arrancar. El registro público siempre da rol `cliente`.
ADMIN_EMAIL = entorno.get("ORION_ADMIN_EMAIL", "admin@comercio.test")
ADMIN_PASS  = entorno.get("ORION_ADMIN_PASS", "admin-de-juguete")

-- Carpeta para archivos temporales (informes y facturas). Lo importante está en Postgres.
TMP = entorno.get("ORION_TMP", "tmp")

-- URL con la que otros servicios llaman a esta tienda (el aviso de la pasarela).
-- En el compose es el balanceador; en un solo proceso, este mismo.
URL_INTERNA = entorno.get("ORION_URL_INTERNA", "http://127.0.0.1:" + str(PORT))

-- Sin ORION_PASARELA_URL, la pasarela simulada se monta en este servidor bajo /pasarela.
PASARELA_URL       = entorno.get("ORION_PASARELA_URL", URL_INTERNA + "/pasarela")
PASARELA_INTEGRADA = entorno.get("ORION_PASARELA_URL", "") == ""

-- Clave de la tienda ante la pasarela y secreto de firma de los avisos.
-- Deben coincidir en ambos servicios.
PASARELA_CLAVE   = entorno.get("ORION_PASARELA_CLAVE", "clave-de-desarrollo")
PASARELA_SECRETO = entorno.get("ORION_PASARELA_SECRETO", "secreto-de-desarrollo")

-- Minutos que se reserva el stock de un pedido sin pagar.
PAGO_MINUTOS = int(entorno.get("ORION_PAGO_MINUTOS", "15"))

-- SMTP para enviar facturas. Sin ORION_SMTP_HOST no se envía correo.
SMTP = {
    "servidor":  entorno.get("ORION_SMTP_HOST", ""),
    "puerto":    int(entorno.get("ORION_SMTP_PUERTO", "587")),
    "seguridad": entorno.get("ORION_SMTP_SEGURIDAD", "starttls"),
    "usuario":   entorno.get("ORION_SMTP_USUARIO", ""),
    "clave":     entorno.get("ORION_SMTP_CLAVE", "")
}
CORREO_DE = entorno.get("ORION_CORREO_DE", "Comercio <tienda@comercio.test>")

-- Color de la marca en facturas e informes.
COLOR_MARCA = entorno.get("ORION_COLOR_MARCA", "#1f6f4a")

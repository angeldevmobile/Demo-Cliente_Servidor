-- Cola de trabajos en Postgres: la comparten todas las instancias y sobrevive a reinicios.
use "db" as db
use "backend/base/config" as config

fn encolar(tipo, datos_json) {
    return db.insert(config.BD,
        "INSERT INTO trabajos (tipo, datos) VALUES (?, ?) RETURNING id", [tipo, datos_json])
}

-- Toma el siguiente trabajo en una sola sentencia. FOR UPDATE SKIP LOCKED evita
-- que dos workers tomen el mismo.
fn tomar(worker) {
    return db.first(config.BD, "
        UPDATE trabajos
        SET estado = 'procesando',
            intentos = intentos + 1,
            tomado_por = ?,
            tomado_en = now()
        WHERE id = (
            SELECT id FROM trabajos
            WHERE estado = 'pendiente' AND ejecutar_en <= now()
            ORDER BY id
            FOR UPDATE SKIP LOCKED
            LIMIT 1
        )
        RETURNING id, tipo, datos, intentos, max_intentos", [worker])
}

fn terminar(id) {
    db.exec(config.BD, "UPDATE trabajos SET estado = 'hecho', terminado = now(), error = NULL
                        WHERE id = ?", [id])
}

-- Si falla, reintenta con espera creciente (5 s, 10 s, 20 s…).
-- Al agotar los intentos lo marca como 'fallido'.
fn fallar(id, mensaje, intentos, max_intentos) {
    if intentos >= max_intentos {
        db.exec(config.BD, "UPDATE trabajos SET estado = 'fallido', error = ?, terminado = now()
                            WHERE id = ?", [mensaje, id])
        return "fallido"
    }
    espera = 5 * intentos
    db.exec(config.BD, "UPDATE trabajos
                        SET estado = 'pendiente', error = ?,
                            ejecutar_en = now() + (? || ' seconds')::interval
                        WHERE id = ?", [mensaje, str(espera), id])
    return "reintentara"
}

-- Devuelve a la cola los trabajos de un worker que se detuvo a mitad.
fn rescatar(minutos) {
    db.exec(config.BD, "UPDATE trabajos
                        SET estado = 'pendiente', tomado_por = NULL, tomado_en = NULL
                        WHERE estado = 'procesando'
                          AND tomado_en < now() - (? || ' minutes')::interval",
            [str(minutos)])
}

fn estadisticas() {
    fuera = {}
    for f in db.query(config.BD, "SELECT estado, COUNT(*) AS n FROM trabajos GROUP BY estado") {
        fuera[f["estado"]] = f["n"]
    }
    return fuera
}

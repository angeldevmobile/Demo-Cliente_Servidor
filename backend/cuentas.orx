-- Cuentas: registro, login y tokens JWT.
use "db" as db
use "auth" as auth
use "validate" as valida
use "backend/config" as config

MIN_PASS = 8

-- Devuelve { ok, error }; el handler decide el código HTTP.
fn revisar_datos(email, pass, nombre) {
    if not valida.email(email) {
        return { "ok": no, "error": "ese email no tiene buena pinta" }
    }
    if len(pass) < MIN_PASS {
        return { "ok": no, "error": "la contraseña necesita al menos " + str(MIN_PASS) + " caracteres" }
    }
    if len(nombre.trim()) < 2 {
        return { "ok": no, "error": "falta el nombre" }
    }
    return { "ok": yes, "error": "" }
}

fn existe(email) {
    return db.first(config.BD, "SELECT id FROM usuarios WHERE email = ?", [email.lower()]) != null
}

fn registrar(email, pass, nombre) {
    revision = revisar_datos(email, pass, nombre)
    if not revision["ok"] {
        return revision
    }
    if existe(email) {
        return { "ok": no, "error": "ya hay una cuenta con ese email" }
    }

    -- Solo se guarda el hash argon2id de la contraseña.
    id = db.insert(config.BD,
        "INSERT INTO usuarios (email, hash_pass, nombre) VALUES (?, ?, ?) RETURNING id",
        [email.lower(), auth.hash(pass), nombre.trim()])

    return { "ok": yes, "error": "", "usuario": { "id": id, "email": email.lower(), "nombre": nombre.trim(), "rol": "cliente" } }
}

fn login(email, pass) {
    u = db.first(config.BD,
        "SELECT id, email, nombre, rol, hash_pass FROM usuarios WHERE email = ?", [email.lower()])

    -- Mismo mensaje si el email no existe o la contraseña es incorrecta,
    -- para no revelar qué emails están registrados.
    if u == null or not auth.verify(pass, u["hash_pass"]) {
        return { "ok": no, "error": "email o contraseña incorrectos" }
    }

    return {
        "ok": yes, "error": "",
        "token": emitir_token(u),
        "usuario": { "id": u["id"], "email": u["email"], "nombre": u["nombre"], "rol": u["rol"] }
    }
}

fn emitir_token(u) {
    return auth.token(
        { "sub": u["id"], "email": u["email"], "nombre": u["nombre"], "rol": u["rol"] },
        config.JWT_SECRETO,
        config.JWT_HORAS * 3600)
}

-- El id del usuario viene del JWT, ya validado por router.guard.
fn id_de(req) {
    if not has_key(req, "user") {
        return 0
    }
    attempt {
        return int(req["user"]["sub"])
    } handle err {
        return 0
    }
}

fn por_id(id) {
    return db.first(config.BD, "SELECT id, email, nombre, rol, creado FROM usuarios WHERE id = ?", [id])
}

fn es_admin(req) {
    return has_key(req, "user") and req["user"]["rol"] == "admin"
}

-- Pedidos: la compra y el historial.
use "db" as db
use "backend/base/config" as config
use "backend/tienda/carrito" as carrito

-- Estados que cuentan como venta. Un pedido sin pagar reserva stock, pero no es una venta.
ESTADOS_VENTA = "('pagado', 'enviado', 'entregado')"
VENDIDO = "estado IN " + ESTADOS_VENTA

-- Compra completa en una transacción. Primero descuenta stock: si no alcanza, el CHECK
-- (stock >= 0) revierte todo. El pedido queda 'pendiente_pago' hasta `expira`.
fn comprar(usuario_id) {
    cid = carrito.carrito_de(usuario_id)
    cuenta = db.first(config.BD, "SELECT COUNT(*) AS n FROM lineas WHERE carrito_id = ?", [cid])
    if cuenta["n"] == 0 {
        return { "ok": no, "error": "el carrito está vacío", "agotadas": [] }
    }

    pasos = [
        ["UPDATE productos p SET stock = p.stock - l.cantidad
          FROM lineas l WHERE l.producto_id = p.id AND l.carrito_id = ?", [cid]],

        ["INSERT INTO pedidos (usuario_id, total, estado, expira)
          SELECT ?, COALESCE(SUM(p.precio * l.cantidad), 0), 'pendiente_pago',
                 now() + (? || ' minutes')::interval
          FROM lineas l JOIN productos p ON p.id = l.producto_id
          WHERE l.carrito_id = ?", [usuario_id, str(config.PAGO_MINUTOS), cid]],

        -- currval devuelve el id generado en esta misma sesión, sin mezclarse con otras compras.
        ["INSERT INTO pedido_items (pedido_id, producto_id, cantidad, precio_unitario)
          SELECT currval('pedidos_id_seq'), l.producto_id, l.cantidad, p.precio
          FROM lineas l JOIN productos p ON p.id = l.producto_id
          WHERE l.carrito_id = ?", [cid]],

        ["DELETE FROM lineas WHERE carrito_id = ?", [cid]]
    ]

    attempt {
        db.transaction(config.BD, pasos)
    } handle err {
        -- 23514: el CHECK (stock >= 0) revirtió la compra.
        if str(err).contains("SQLSTATE 23514") {
            return sin_stock(cid)
        }
        return { "ok": no, "error": "no se pudo completar la compra: " + str(err), "agotadas": [] }
    }

    return { "ok": yes, "error": "", "pedido": ultimo(usuario_id) }
}

-- Líneas sin stock suficiente, solo para el mensaje de error.
fn sin_stock(carrito_id) {
    lineas = db.query(config.BD, "
        SELECT l.id, p.nombre, p.stock FROM lineas l
        JOIN productos p ON p.id = l.producto_id
        WHERE l.carrito_id = ? AND l.cantidad > p.stock
        ORDER BY l.id", [carrito_id])
    if len(lineas) == 0 {
        return { "ok": no, "error": "alguien se ha llevado las últimas unidades antes que tú", "agotadas": [] }
    }
    nombres = []
    ids = []
    for l in lineas {
        nombres.push(l["nombre"] + " (quedan " + str(l["stock"]) + ")")
        ids.push(l["id"])
    }
    return { "ok": no, "error": "sin unidades suficientes de: " + nombres.join(", "), "agotadas": ids }
}

fn ultimo(usuario_id) {
    p = db.first(config.BD, "SELECT id, total, estado, creado, expira FROM pedidos
                             WHERE usuario_id = ? ORDER BY id DESC LIMIT 1", [usuario_id])
    if p == null {
        return null
    }
    p["items"] = items(p["id"])
    return p
}

fn items(pedido_id) {
    return db.query(config.BD, "
        SELECT i.cantidad, i.precio_unitario, p.sku, p.nombre,
               (i.precio_unitario * i.cantidad) AS subtotal
        FROM pedido_items i JOIN productos p ON p.id = i.producto_id
        WHERE i.pedido_id = ? ORDER BY i.id", [pedido_id])
}

-- Historial con sus líneas. `factura` es null hasta que el worker la genera.
fn mios(usuario_id) {
    fuera = []
    for p in db.query(config.BD, "SELECT p.id, p.total, p.estado, p.creado, p.expira, p.pago_motivo,
                                         f.numero AS factura, f.enviada IS NOT NULL AS factura_enviada
                                  FROM pedidos p LEFT JOIN facturas f ON f.pedido_id = p.id
                                  WHERE p.usuario_id = ? ORDER BY p.id DESC LIMIT 20", [usuario_id]) {
        p["items"] = items(p["id"])
        fuera.push(p)
    }
    return fuera
}

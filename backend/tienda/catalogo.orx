-- Catálogo: productos, búsqueda y filtros.
use "db" as db
use "regex" as regex
use "backend/base/config" as config

-- "tecla mecan" → "tecla:* & mecan:*": cada palabra se busca como prefijo.
-- Solo se admiten letras y dígitos, así la entrada no puede romper la consulta.
fn tsquery(busqueda) {
    partes = []
    for p in regex.find_all(busqueda.lower(), "[\\p{L}\\p{N}]+") {
        partes.push(p + ":*")
    }
    return partes.join(" & ")
}

-- Condición de búsqueda para la tienda y el panel: texto completo (GIN) o SKU exacto.
fn filtro_busqueda(busqueda) {
    q = tsquery(busqueda)
    if q == "" {
        return ["sku = ?", [busqueda.upper()]]
    }
    return ["(busqueda @@ to_tsquery('spanish', ?) OR sku = ?)", [q, busqueda.upper()]]
}

-- Devuelve [sql, params]. Con búsqueda, filtra primero (CTE MATERIALIZED) y ordena después,
-- para que Postgres use el índice GIN en lugar de recorrer la tabla en orden.
fn consulta(busqueda, categoria, tope) {
    columnas = "id, sku, nombre, descripcion, categoria, precio, stock"
    donde = "activo = true"
    params = []
    if busqueda != "" {
        f = filtro_busqueda(busqueda)
        donde = donde + " AND " + f[0]
        params = params + f[1]
    }
    if categoria != "" {
        donde = donde + " AND categoria = ?"
        params = params + [categoria]
    }
    orden = " ORDER BY categoria, nombre LIMIT " + str(tope)
    if busqueda == "" {
        return ["SELECT " + columnas + " FROM productos WHERE " + donde + orden, params]
    }
    return ["WITH m AS MATERIALIZED (SELECT " + columnas + " FROM productos WHERE " + donde + ")
             SELECT * FROM m" + orden, params]
}

fn listar(busqueda, categoria, limite) {
    tope = 60
    if limite > 0 and limite < 200 {
        tope = limite
    }
    c = consulta(busqueda, categoria, tope)
    return db.query(config.BD, c[0], c[1])
}

-- Ficha del producto: detalle, características como lista y productos de la misma categoría.
fn por_sku(sku) {
    p = db.first(config.BD, "SELECT id, sku, nombre, descripcion, categoria, precio, stock,
                                    detalle, caracteristicas
                             FROM productos WHERE sku = ? AND activo = true", [sku])
    if p == null {
        return null
    }
    lista = []
    if p["caracteristicas"] != "" {
        lista = p["caracteristicas"].split("|")
    }
    p["caracteristicas"] = lista
    p["relacionados"] = db.query(config.BD, "
        SELECT id, sku, nombre, descripcion, categoria, precio, stock
        FROM productos
        WHERE categoria = ? AND sku <> ? AND activo = true
        ORDER BY nombre LIMIT 4", [p["categoria"], sku])
    return p
}

fn por_id(id) {
    return db.first(config.BD, "SELECT id, sku, nombre, precio, stock
                                FROM productos WHERE id = ? AND activo = true", [id])
}

-- Categorías calculadas desde los productos activos.
fn categorias() {
    fuera = []
    filas = db.query(config.BD, "SELECT categoria, COUNT(*) AS n
                                 FROM productos WHERE activo = true
                                 GROUP BY categoria ORDER BY categoria")
    for f in filas {
        fuera.push({ "nombre": f["categoria"], "productos": f["n"] })
    }
    return fuera
}

fn resumen() {
    return db.first(config.BD, "SELECT COUNT(*) AS productos,
                                       COALESCE(SUM(stock), 0) AS unidades,
                                       COUNT(*) FILTER (WHERE stock = 0) AS agotados
                                FROM productos WHERE activo = true")
}

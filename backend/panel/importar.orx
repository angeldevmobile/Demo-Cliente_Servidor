-- Importación masiva del catálogo desde CSV con COPY.
-- Para archivos grandes, herramientas/importar.orx.
use "db" as db
use "csv" as csv
use "fs" as fs
use "crypto" as crypto
use "timewarp" as tw
use "backend/base/config" as config

COLUMNAS = ["sku", "nombre", "descripcion", "categoria", "precio", "stock"]
-- Columnas opcionales de la ficha. Si el archivo no las trae, se conservan las actuales.
OPCIONALES = ["detalle", "caracteristicas"]

-- Columnas del CSV en su orden (COPY las asigna por posición). Solo lee la cabecera.
fn columnas_de(ruta) {
    cabecera = []
    for c in csv.headers(ruta) {
        cabecera.push(c.lower())
    }
    for c in COLUMNAS {
        if not cabecera.contains(c) {
            error("al CSV le falta la columna '" + c + "'. Hacen falta: " + COLUMNAS.join(", "))
        }
    }
    for c in cabecera {
        if not COLUMNAS.contains(c) and not OPCIONALES.contains(c) {
            error("columna desconocida '" + c + "'. Valen: " + (COLUMNAS + OPCIONALES).join(", "))
        }
    }
    return cabecera
}

-- COPY a una tabla temporal UNLOGGED, validación de todas las filas
-- y fusión con el catálogo en una sola sentencia.
fn cargar(ruta) {
    reloj = tw.clock()
    columnas = columnas_de(ruta)
    paso = "carga_" + crypto.token(12)

    db.exec(config.BD, "CREATE UNLOGGED TABLE " + paso + " (
        sku TEXT, nombre TEXT, descripcion TEXT, categoria TEXT, precio TEXT, stock TEXT,
        detalle TEXT, caracteristicas TEXT
    )")

    attempt {
        r = copiar_y_fusionar(paso, ruta, columnas, reloj)
    } handle err {
        db.exec(config.BD, "DROP TABLE IF EXISTS " + paso)
        error(str(err))
    }
    db.exec(config.BD, "DROP TABLE IF EXISTS " + paso)

    -- Actualiza las estadísticas del planificador después de una carga grande.
    db.exec(config.BD, "ANALYZE productos")

    r["segundos"] = tw.elapsed(reloj)
    return r
}

fn copiar_y_fusionar(paso, ruta, columnas, reloj) {
    filas = db.copy_file(config.BD, paso, columnas, ruta, { "header": yes })
    s_copia = tw.elapsed(reloj)

    problema = revisar(paso)
    if problema != "" {
        error(problema)
    }
    s_revision = tw.elapsed(reloj) - s_copia

    -- La ficha solo se actualiza si el archivo incluye esa columna.
    ficha = ""
    for c in OPCIONALES {
        if columnas.contains(c) {
            ficha = ficha + c + " = EXCLUDED." + c + ", "
        }
    }

    -- No modifica el stock de productos existentes; los nuevos entran con el suyo.
    -- `xmax = 0` distingue filas insertadas de actualizadas.
    r = db.first(config.BD, "
        WITH f AS (
            INSERT INTO productos (sku, nombre, descripcion, categoria, precio, stock,
                                   detalle, caracteristicas)
            SELECT sku, nombre, COALESCE(descripcion, ''), lower(categoria),
                   precio::numeric(10,2), stock::integer,
                   COALESCE(detalle, ''), COALESCE(caracteristicas, '')
            FROM " + paso + "
            ON CONFLICT (sku) DO UPDATE SET
                nombre      = EXCLUDED.nombre,
                descripcion = EXCLUDED.descripcion,
                categoria   = EXCLUDED.categoria,
                precio      = EXCLUDED.precio,
                " + ficha + "activo = true
            RETURNING (xmax = 0) AS nuevo
        )
        SELECT COUNT(*) FILTER (WHERE nuevo) AS nuevos,
               COUNT(*) FILTER (WHERE NOT nuevo) AS actualizados
        FROM f")

    return {
        "filas": filas,
        "nuevos": r["nuevos"],
        "actualizados": r["actualizados"],
        "segundos_copia": s_copia,
        "segundos_revision": s_revision,
        "segundos_fusion": tw.elapsed(reloj) - s_copia - s_revision
    }
}

-- Devuelve "" si todo es válido, o las primeras filas con error.
-- Los patrones coinciden con los límites de NUMERIC(10,2) e INTEGER.
fn revisar(paso) {
    malas = db.query(config.BD, "
        SELECT COALESCE(NULLIF(sku, ''), '(sin SKU)') AS sku,
               CASE
                 WHEN COALESCE(sku, '') = ''       THEN 'falta el SKU'
                 WHEN COALESCE(nombre, '') = ''    THEN 'falta el nombre'
                 WHEN COALESCE(categoria, '') = '' THEN 'falta la categoría'
                 WHEN COALESCE(precio, '') !~ '^[0-9]{1,8}([.][0-9]{1,2})?$'
                      THEN 'precio no válido: \"' || COALESCE(precio, '') || '\"'
                 ELSE 'stock no válido: \"' || COALESCE(stock, '') || '\"'
               END AS problema
        FROM " + paso + "
        WHERE COALESCE(sku, '') = '' OR COALESCE(nombre, '') = '' OR COALESCE(categoria, '') = ''
           OR COALESCE(precio, '') !~ '^[0-9]{1,8}([.][0-9]{1,2})?$'
           OR COALESCE(stock, '')  !~ '^[0-9]{1,9}$'
        LIMIT 5")
    if len(malas) > 0 {
        partes = []
        for m in malas {
            partes.push(m["sku"] + ": " + m["problema"])
        }
        return "filas no válidas, no se ha importado nada. " + partes.join("; ")
    }

    repetidos = db.query(config.BD, "SELECT sku FROM " + paso + " GROUP BY sku HAVING COUNT(*) > 1 LIMIT 5")
    if len(repetidos) > 0 {
        skus = []
        for f in repetidos {
            skus.push(f["sku"])
        }
        return "SKU repetidos en el archivo, no se ha importado nada: " + skus.join(", ")
    }
    return ""
}

-- Límite de subida por HTTP: serve carga el cuerpo completo en memoria.
-- Para más, usar la herramienta de línea de comandos.
MAX_SUBIDA = 50 * 1048576

-- CSV subido desde el panel. El archivo temporal se borra siempre, también si falla.
fn desde_subida(archivo) {
    ruta = archivo["tmp_path"]
    if archivo["size"] > MAX_SUBIDA {
        fs.delete(ruta)
        return { "ok": no, "codigo": 413,
                 "error": "para archivos de más de 50 MB, usa herramientas/importar.orx" }
    }
    attempt {
        r = cargar(ruta)
    } handle err {
        fs.delete(ruta)
        return { "ok": no, "codigo": 400, "error": str(err) }
    }
    fs.delete(ruta)
    return { "ok": yes, "codigo": 200, "error": "", "resultado": r }
}

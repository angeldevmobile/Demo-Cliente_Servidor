-- Esquema y siembra. Idempotente: arrancar dos veces no duplica nada.
use "db" as db
use "csv" as csv
use "auth" as auth
use "backend/config" as config

fn crear_esquema() {
    pasos = []

    pasos.push(["CREATE TABLE IF NOT EXISTS usuarios (
        id        SERIAL PRIMARY KEY,
        email     TEXT NOT NULL UNIQUE,
        hash_pass TEXT NOT NULL,
        nombre    TEXT NOT NULL,
        rol       TEXT NOT NULL DEFAULT 'cliente',
        creado    TIMESTAMPTZ NOT NULL DEFAULT now()
    )", []])

    pasos.push(["CREATE TABLE IF NOT EXISTS productos (
        id          SERIAL PRIMARY KEY,
        sku         TEXT NOT NULL UNIQUE,
        nombre      TEXT NOT NULL,
        descripcion TEXT NOT NULL DEFAULT '',
        categoria   TEXT NOT NULL,
        precio      NUMERIC(10,2) NOT NULL CHECK (precio >= 0),
        stock       INTEGER NOT NULL DEFAULT 0 CHECK (stock >= 0),
        activo      BOOLEAN NOT NULL DEFAULT true
    )", []])

    -- La ficha del producto. Columnas añadidas después: ALTER para que una
    -- base ya creada las gane sin migraciones a mano. Las características
    -- van separadas por '|'.
    pasos.push(["ALTER TABLE productos
                 ADD COLUMN IF NOT EXISTS detalle TEXT NOT NULL DEFAULT '',
                 ADD COLUMN IF NOT EXISTS caracteristicas TEXT NOT NULL DEFAULT ''", []])

    pasos.push(["CREATE INDEX IF NOT EXISTS idx_prod_categoria ON productos (categoria)", []])

    -- El orden del catálogo. Sin este índice, pedir los 60 primeros de un
    -- millón obliga a ordenar el millón entero en cada visita.
    pasos.push(["CREATE INDEX IF NOT EXISTS idx_prod_orden ON productos (categoria, nombre)
                        WHERE activo", []])

    -- Búsqueda de texto completo: con un millón de filas, ILIKE '%texto%'
    -- recorre la tabla entera. La columna se calcula sola en cada escritura.
    pasos.push(["ALTER TABLE productos ADD COLUMN IF NOT EXISTS busqueda tsvector
                        GENERATED ALWAYS AS (
                            to_tsvector('spanish', sku || ' ' || nombre || ' ' || descripcion)
                        ) STORED", []])
    pasos.push(["CREATE INDEX IF NOT EXISTS idx_prod_busqueda ON productos USING gin (busqueda)", []])

    pasos.push(["CREATE TABLE IF NOT EXISTS carritos (
        id         SERIAL PRIMARY KEY,
        usuario_id INTEGER NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
        creado     TIMESTAMPTZ NOT NULL DEFAULT now()
    )", []])

    pasos.push(["CREATE TABLE IF NOT EXISTS lineas (
        id          SERIAL PRIMARY KEY,
        carrito_id  INTEGER NOT NULL REFERENCES carritos(id) ON DELETE CASCADE,
        producto_id INTEGER NOT NULL REFERENCES productos(id),
        cantidad    INTEGER NOT NULL CHECK (cantidad > 0),
        UNIQUE (carrito_id, producto_id)
    )", []])

    pasos.push(["CREATE TABLE IF NOT EXISTS pedidos (
        id         SERIAL PRIMARY KEY,
        usuario_id INTEGER NOT NULL REFERENCES usuarios(id),
        total      NUMERIC(10,2) NOT NULL,
        estado     TEXT NOT NULL DEFAULT 'pagado',
        creado     TIMESTAMPTZ NOT NULL DEFAULT now()
    )", []])

    -- El precio se copia en la línea: un pedido de ayer no puede cambiar de
    -- importe porque hoy se haya subido el precio del producto.
    pasos.push(["CREATE TABLE IF NOT EXISTS pedido_items (
        id              SERIAL PRIMARY KEY,
        pedido_id       INTEGER NOT NULL REFERENCES pedidos(id) ON DELETE CASCADE,
        producto_id     INTEGER NOT NULL REFERENCES productos(id),
        cantidad        INTEGER NOT NULL CHECK (cantidad > 0),
        precio_unitario NUMERIC(10,2) NOT NULL
    )", []])

    pasos.push(["CREATE INDEX IF NOT EXISTS idx_items_pedido ON pedido_items (pedido_id)", []])

    -- El pago: un pedido nace 'pendiente_pago' con el stock reservado hasta
    -- `expira`; la pasarela confirma con un aviso firmado.
    pasos.push(["ALTER TABLE pedidos
                 ADD COLUMN IF NOT EXISTS expira      TIMESTAMPTZ,
                 ADD COLUMN IF NOT EXISTS cargo_id    TEXT,
                 ADD COLUMN IF NOT EXISTS url_pago    TEXT,
                 ADD COLUMN IF NOT EXISTS pago_motivo TEXT,
                 ADD COLUMN IF NOT EXISTS pagado_en   TIMESTAMPTZ", []])
    pasos.push(["CREATE INDEX IF NOT EXISTS idx_pedidos_por_pagar ON pedidos (expira)
                 WHERE estado = 'pendiente_pago'", []])

    -- Un aviso por id: la pasarela reenvía, y `veces` cuenta cuántas llegaron.
    pasos.push(["CREATE TABLE IF NOT EXISTS pagos_avisos (
        id        TEXT PRIMARY KEY,
        evento    TEXT NOT NULL,
        cargo_id  TEXT NOT NULL,
        pedido_id INTEGER,
        resultado TEXT NOT NULL,
        veces     INTEGER NOT NULL DEFAULT 1,
        recibido  TIMESTAMPTZ NOT NULL DEFAULT now(),
        ultimo    TIMESTAMPTZ NOT NULL DEFAULT now()
    )", []])

    -- Cola de trabajos en segundo plano.
    pasos.push(["CREATE TABLE IF NOT EXISTS trabajos (
        id           SERIAL PRIMARY KEY,
        tipo         TEXT NOT NULL,
        datos        TEXT NOT NULL DEFAULT '{}',
        estado       TEXT NOT NULL DEFAULT 'pendiente',
        intentos     INTEGER NOT NULL DEFAULT 0,
        max_intentos INTEGER NOT NULL DEFAULT 3,
        ejecutar_en  TIMESTAMPTZ NOT NULL DEFAULT now(),
        tomado_por   TEXT,
        tomado_en    TIMESTAMPTZ,
        error        TEXT,
        creado       TIMESTAMPTZ NOT NULL DEFAULT now(),
        terminado    TIMESTAMPTZ
    )", []])

    -- El índice es lo que hace barata la búsqueda del siguiente trabajo
    -- cuando la tabla acumula millones de terminados.
    pasos.push(["CREATE INDEX IF NOT EXISTS idx_trabajos_pendientes
                        ON trabajos (estado, ejecutar_en, id)
                        WHERE estado = 'pendiente'", []])

    pasos.push(["CREATE TABLE IF NOT EXISTS facturas (
        id        SERIAL PRIMARY KEY,
        pedido_id INTEGER NOT NULL UNIQUE REFERENCES pedidos(id) ON DELETE CASCADE,
        numero    TEXT NOT NULL,
        contenido TEXT NOT NULL,
        creada    TIMESTAMPTZ NOT NULL DEFAULT now()
    )", []])

    -- La factura en PDF y si ya se mandó por correo.
    pasos.push(["ALTER TABLE facturas
                 ADD COLUMN IF NOT EXISTS pdf          BYTEA,
                 ADD COLUMN IF NOT EXISTS bytes        INTEGER,
                 ADD COLUMN IF NOT EXISTS enviada      TIMESTAMPTZ,
                 ADD COLUMN IF NOT EXISTS correo_error TEXT", []])

    -- Informes de ventas. El archivo generado se guarda AQUÍ, no en el disco
    -- del worker: el worker que lo genera y la instancia web que lo sirve son
    -- procesos distintos, y en el compose ni siquiera comparten disco.
    pasos.push(["CREATE TABLE IF NOT EXISTS informes (
        id         SERIAL PRIMARY KEY,
        formato    TEXT NOT NULL CHECK (formato IN ('xlsx', 'pdf')),
        desde      DATE NOT NULL,
        hasta      DATE NOT NULL,
        estado     TEXT NOT NULL DEFAULT 'pendiente',
        pedido_por INTEGER REFERENCES usuarios(id),
        contenido  BYTEA,
        bytes      INTEGER,
        error      TEXT,
        creado     TIMESTAMPTZ NOT NULL DEFAULT now(),
        terminado  TIMESTAMPTZ,
        CHECK (hasta >= desde)
    )", []])

    -- Una fila por proceso (instancia web o worker), con su última señal de
    -- vida: es lo que enseña /monitor.html.
    pasos.push(["CREATE TABLE IF NOT EXISTS procesos (
        nombre  TEXT PRIMARY KEY,
        tipo    TEXT NOT NULL,
        version TEXT NOT NULL,
        pid     BIGINT NOT NULL,
        arranco TIMESTAMPTZ NOT NULL,
        senal   TIMESTAMPTZ NOT NULL,
        rss     BIGINT NOT NULL DEFAULT 0,
        pico    BIGINT NOT NULL DEFAULT 0
    )", []])
    -- Todos los procesos crean el esquema al arrancar, y sobre una base vacía
    -- CREATE ... IF NOT EXISTS choca si dos lo hacen a la vez (23505). El
    -- candado deja pasar a uno; los demás esperan y ya lo encuentran hecho.
    db.transaction(config.BD, [["SELECT pg_advisory_xact_lock(7311)", []]] + pasos)
}

-- La cuenta de administración. Si alguien se registró antes con ese email,
-- NO se le asciende: bastaría con adelantarse al arranque registrando el
-- email del admin para quedarse con el panel.
fn sembrar_admin(email, pass) {
    if email == "" {
        return no
    }
    if db.first(config.BD, "SELECT id FROM usuarios WHERE email = ?", [email.lower()]) != null {
        return no
    }
    -- ON CONFLICT por si otra instancia lo sembró entre la consulta y aquí.
    db.exec(config.BD, "INSERT INTO usuarios (email, hash_pass, nombre, rol)
                        VALUES (?, ?, 'Administración', 'admin')
                        ON CONFLICT (email) DO NOTHING",
            [email.lower(), auth.hash(pass)])
    return yes
}

fn sembrar_catalogo(ruta_csv) {
    cuenta = db.first(config.BD, "SELECT COUNT(*) AS n FROM productos")
    if cuenta["n"] > 0 {
        return 0
    }

    puestos = 0
    for p in csv.read(ruta_csv) {
        db.exec(config.BD, "INSERT INTO productos
                                (sku, nombre, descripcion, categoria, precio, stock, detalle, caracteristicas)
                            VALUES (?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT (sku) DO NOTHING",
                [p["sku"], p["nombre"], p["descripcion"], p["categoria"],
                 float(p["precio"]), int(p["stock"]), p["detalle"], p["caracteristicas"]])
        puestos = puestos + 1
    }
    return puestos
}

-- Una base sembrada antes de que existiera la ficha se queda con el detalle
-- vacío: esto lo rellena desde el CSV, sin pisar lo que ya se haya editado.
fn completar_fichas(ruta_csv) {
    for p in csv.read(ruta_csv) {
        db.exec(config.BD, "UPDATE productos SET detalle = ?, caracteristicas = ?
                            WHERE sku = ? AND detalle = ''",
                [p["detalle"], p["caracteristicas"], p["sku"]])
    }
}

fn preparar(ruta_csv) {
    crear_esquema()
    sembrar_admin(config.ADMIN_EMAIL, config.ADMIN_PASS)
    puestos = sembrar_catalogo(ruta_csv)
    completar_fichas(ruta_csv)
    return puestos
}

# Secretos de la demo. Copia este archivo a .env (que no se sube a git) y cambia los valores:
#   cp .env.example .env
# En producción no se usa .env: ORION_ENV=production y variables de entorno reales.

# Contraseña del Postgres del docker-compose.
POSTGRES_PASSWORD=cambia-esta-clave

# Base de datos para ejecutar la tienda fuera de Docker (puerto 5433 del compose).
ORION_BD=postgres://comercio:cambia-esta-clave@127.0.0.1:5433/comercio

# Firma de los JWT: mínimo 32 caracteres aleatorios.
ORION_JWT=genera-32-o-mas-caracteres-aleatorios

# Cuenta de administración que se crea al arrancar (mínimo 12 caracteres).
ORION_ADMIN_EMAIL=admin@comercio.test
ORION_ADMIN_PASS=cambia-esta-clave-de-admin

# Clave de la tienda ante la pasarela (16+) y secreto de firma de sus avisos (32+).
ORION_PASARELA_CLAVE=genera-16-o-mas-caracteres
ORION_PASARELA_SECRETO=genera-32-o-mas-caracteres-aleatorios
